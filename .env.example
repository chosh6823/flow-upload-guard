# ---------------------------------------------------------------------------
# 필수
# ---------------------------------------------------------------------------

# Postgres 연결 문자열.
#   로컬:  postgresql://postgres:postgres@localhost:5432/upload_guard?sslmode=disable
#   Neon:  postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# ⚠ Vercel 등 서버리스에 배포할 때는 반드시 **pooler 엔드포인트**를 쓸 것.
#   직결 엔드포인트를 쓰면 함수 인스턴스가 조금만 늘어도 커넥션 상한에 부딪힌다.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upload_guard?sslmode=disable


# ---------------------------------------------------------------------------
# 선택 (기본값이 안전한 쪽으로 설정되어 있다)
# ---------------------------------------------------------------------------

# 확장자 스캔 모드
#   all  (기본) : 파일명의 모든 점 구간 검사. `resume.exe.pdf` 차단됨
#   last        : 마지막 확장자만 검사. `resume.exe.pdf` 통과됨
# EXTENSION_SCAN_MODE=all

# 매직넘버 검사로 실행 파일을 차단할지 (기본 true)
# 'false' 로 두면 확장자만 위장한 exe 가 통과한다 — 시연용으로만 끌 것.
# BLOCK_EXECUTABLE_SIGNATURE=true

# 저장 드라이버
#   none  (기본) : 검증만 하고 본문은 버린다. Vercel 등 파일시스템 휘발 환경용.
#   local        : STORAGE_DIR 에 UUID 파일명으로 저장. 자체 호스팅/로컬 개발용.
# STORAGE_DRIVER=none

# STORAGE_DRIVER=local 일 때의 저장 경로. 반드시 public/ 바깥이어야 한다.
# STORAGE_DIR=./storage

# 커넥션 풀 최대 크기 (서버리스는 작게)
# PGPOOL_MAX=3

# TLS 검증을 끄려면 off. 로컬 Postgres 처럼 TLS 가 없는 경우.
# (DATABASE_URL 에 sslmode=disable 을 넣어도 동일하게 처리된다)
# PGSSL=off
